@page "/login"
@inject IPortalApiClient ApiClient
@inject PortalUserSessionService SessionService

<PageTitle>Sign In | EnterpriseEmployeePortal</PageTitle>

<div class="surface-card" style="max-width: 520px; margin: 2rem auto;">
    <h1 style="margin-top:0;">Portal Authentication</h1>
    <p style="color:#475569;">Sign in against <code>POST /api/auth/login</code> using dummy test accounts (e.g., <code>admin</code> / <code>Admin@123!</code>).</p>

    <EditForm Model="_loginModel" OnValidSubmit="HandleLoginAsync">
        <DataAnnotationsValidator />
        <div style="margin-bottom: 1rem;">
            <label>Username</label>
            <InputText class="form-control" @bind-Value="_loginModel.Username" />
        </div>
        <div style="margin-bottom: 1rem;">
            <label>Password</label>
            <InputText type="password" class="form-control" @bind-Value="_loginModel.Password" />
        </div>
        <button type="submit" class="btn btn-primary">Authenticate</button>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="surface-card" style="margin-top: 1rem; background: #f1f5f9;">
            <strong>Status:</strong> @_statusMessage
            @if (!string.IsNullOrWhiteSpace(SessionService.JwtToken))
            {
                <div style="margin-top:0.5rem; word-break:break-all; font-size:0.78rem;">
                    <strong>Issued JWT:</strong> <code>@SessionService.JwtToken</code>
                </div>
            }
        </div>
    }
</div>

@code {
    private LoginRequestDto _loginModel = new() { Username = "admin", Password = "Admin@123!" };
    private string? _statusMessage;

    private async Task HandleLoginAsync()
    {
        try
        {
            var result = await ApiClient.LoginAsync(_loginModel);
            _statusMessage = result.Message;
            if (result.Succeeded)
            {
                SessionService.SetSession(result);
            }
        }
        catch (Exception ex)
        {
            _statusMessage = $"API connection error: {ex.Message}";
        }
    }
}

